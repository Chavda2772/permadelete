<controls:FlatWindow x:Class="Permadelete.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Permadelete.Controls"
        xmlns:xaml="clr-namespace:Permadelete.Xaml"
                     xmlns:system="clr-namespace:System;assembly=mscorlib" WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        mc:Ignorable="d" Icon="/Images/icon_24.png" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Title="Settings" Height="500" Width="520">

    <controls:FlatWindow.Resources>
        <xaml:ColorToBrushConverter x:Key="colorConverter" />

        <Style x:Key="sectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </controls:FlatWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="15, 10">
            <TextBlock Text="Theme" Style="{StaticResource sectionHeader}" />
            <ListView ItemsSource="{Binding Themes}" Background="Transparent" BorderBrush="Transparent"
                      SelectedItem="{Binding SelectedTheme}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="0, 5, 0, 10" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="2" BorderBrush="{Binding Data.AccentLightColor, Converter={StaticResource colorConverter}}"
                                BorderThickness="1" Background="{Binding Data.AccentColor, Converter={StaticResource colorConverter}}"
                                Padding="2" Width="80" Height="80">
                            <Grid>
                                <TextBlock Text="{Binding Data.Name}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Data.BackgroundColor, Converter={StaticResource colorConverter}}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />

                                <Image Source="/Images/success.png" Width="24" Height="24"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Visibility="{Binding IsSelected, Converter={StaticResource bool2VisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Separator Margin="0, 5, 0, 10" />

            <TextBlock Style="{StaticResource sectionHeader}">
                <Run>Security &amp; Anti-Recovery</Run>
                <Hyperlink FontSize="12" Command="{Binding OpenMoreInfoCommand}">More Info</Hyperlink>
            </TextBlock>

            <TextBlock Text="Default number of overwrite passes: (1 is standard, 3+ for DoD/NSA patterns)" Margin="0, 5, 0, 2" />
            <ComboBox Margin="0, 2, 0, 10" SelectedItem="{Binding DefaultOverwritePasses}">
                <system:Int32>1</system:Int32>
                <system:Int32>3</system:Int32>
                <system:Int32>5</system:Int32>
                <system:Int32>7</system:Int32>
                <system:Int32>10</system:Int32>
            </ComboBox>

            <CheckBox Content="Overwrite files on Solid State Drives (SSDs) and flash drives"
                      IsChecked="{Binding OverwriteSolidStateDrives}" Margin="0, 4" />
            <TextBlock Text="Prevents data recovery tools from carving files before SSD background garbage collection or TRIM runs."
                       FontSize="11" Foreground="Gray" Margin="20, -2, 0, 8" TextWrapping="Wrap" />

            <CheckBox Content="Wipe cluster slack space"
                      IsChecked="{Binding WipeClusterSlack}" Margin="0, 4" />
            <TextBlock Text="Overwrites residual data in the final cluster beyond the logical end of the file."
                       FontSize="11" Foreground="Gray" Margin="20, -2, 0, 8" TextWrapping="Wrap" />

            <CheckBox Content="Wipe NTFS Alternate Data Streams (ADS)"
                      IsChecked="{Binding WipeAlternateDataStreams}" Margin="0, 4" />
            <TextBlock Text="Removes hidden streams such as Zone.Identifier (download source) and auxiliary metadata."
                       FontSize="11" Foreground="Gray" Margin="20, -2, 0, 8" TextWrapping="Wrap" />

            <CheckBox Content="Obfuscate file &amp; folder names and reset timestamps"
                      IsChecked="{Binding ObfuscateNamesAndTimestamps}" Margin="0, 4" />
            <TextBlock Text="Repeatedly scrambles names and resets timestamps to 1980 to erase file system and MFT traces."
                       FontSize="11" Foreground="Gray" Margin="20, -2, 0, 8" TextWrapping="Wrap" />

            <Separator Margin="0, 5, 0, 10" />

            <TextBlock Style="{StaticResource sectionHeader}">
                <Run>Windows Explorer Integration</Run>
            </TextBlock>

            <CheckBox Content="Show 'Shred with Permadelete' in Explorer right-click menu"
                      IsChecked="{Binding ShowInContextMenu}" Margin="0, 4" />
            <TextBlock Text="Allows shredding files and folders directly by right-clicking them in Windows File Explorer."
                       FontSize="11" Foreground="Gray" Margin="20, -2, 0, 8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</controls:FlatWindow>
